---
import Layout from '../layouts/Layout.astro';
import { getLocaleFromUrl } from '../config/site';

const locale = getLocaleFromUrl(Astro.url);
const isEnglish = locale === 'en';
---

<Layout title={isEnglish ? 'Links' : '友情链接'} description={isEnglish ? 'Public links and friends.' : '公开链接与友情链接。'}>
	<section class="mx-auto max-w-4xl px-5 py-20 md:py-28">
		<p class="text-sm font-medium uppercase tracking-[0.28em] text-zinc-500">Links</p>
		<h1 class="mt-4 text-4xl font-semibold text-white md:text-6xl">{isEnglish ? 'Friends and links' : '友情链接'}</h1>
		<p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-400">
			{isEnglish ? 'A small collection of public links worth visiting.' : '一些值得访问的公开链接。'}
		</p>
		<a
			href="https://blog.morizuki.top/"
			target="_blank"
			rel="noreferrer"
			class="mt-12 flex items-center gap-4 rounded-xl border border-white/10 bg-white/[0.04] p-5 transition hover:border-blue-300/50 hover:bg-white/[0.08]"
		>
			<img src="https://blog.morizuki.top/img/avt.jpg" alt="KAFU的小窝" class="h-14 w-14 rounded-full border border-white/20 object-cover" loading="lazy" />
			<span>
				<strong class="block text-lg font-semibold text-white">KAFU的小窝</strong>
				<span class="mt-1 block text-sm text-zinc-400">blog.morizuki.top</span>
			</span>
		</a>
	</section>
</Layout>
